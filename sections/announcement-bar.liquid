<div class="announce">
  <a class="announce__pill" href="{{ section.settings.link | default: routes.all_products_url }}">
    <span>{{ section.settings.text }}</span>
    {% if section.settings.link_label != blank %}
      <span class="announce__link">{{ section.settings.link_label }}</span>
    {% endif %}
  </a>
</div>

{% stylesheet %}
  .announce {
    display: flex;
    justify-content: center;
    padding: 8px 20px;
  }
  .announce__pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 4px 4px 4px 14px;
    font-size: 13px;
    text-decoration: none;
    border-radius: 9999px;
    background: var(--block);
  }
  .announce__link {
    padding: 4px 10px;
    border-radius: 9999px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Ships free, 7–15 business days" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
