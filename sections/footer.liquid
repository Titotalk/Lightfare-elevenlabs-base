<footer class="site-footer">
  <div class="container">
    <div class="site-footer__block">
      <div>
        <p class="site-footer__wordmark">{{ shop.name }}</p>
        <p class="muted site-footer__line">{{ section.settings.text }}</p>
      </div>
      <nav class="site-footer__links" aria-label="Policies">
        {% for policy in shop.policies %}
          <a href="{{ policy.url }}">{{ policy.title }}</a>
        {% endfor %}
      </nav>
    </div>
    <p class="site-footer__copy muted">© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
  </div>
</footer>

{% stylesheet %}
  .site-footer { padding: var(--section-pt) 0 32px; }
  .site-footer__block {
    display: grid;
    gap: 32px;
    padding: 40px;
    border-radius: var(--radius);
    background: var(--block);
  }
  @media (min-width: 750px) {
    .site-footer__block { grid-template-columns: 1fr auto; align-items: end; }
  }
  .site-footer__wordmark {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 300;
  }
  .site-footer__line { margin: 0; font-size: 15px; }
  .site-footer__links { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 14px; }
  .site-footer__links a { text-decoration: none; }
  .site-footer__links a:hover { color: var(--muted); }
  .site-footer__copy { margin: 16px 0 0; font-size: 13px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "text", "label": "Line under the name", "default": "Small bags for people who would rather not check one." }
  ]
}
{% endschema %}
