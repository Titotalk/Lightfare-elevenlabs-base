<section class="section container">
  <div class="intro intro--center">
    <h2 class="display display--lg statement__title">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}
      <p class="intro__text">{{ section.settings.text }}</p>
    {% endif %}
  </div>

  <div class="tiles tiles--3">
    {% for block in section.blocks %}
      <div class="statement__stat" {{ block.shopify_attributes }}>
        <p class="display statement__number">{{ block.settings.number }}</p>
        <p class="statement__label muted">{{ block.settings.label }}</p>
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .statement__title { max-width: 36rem; }
  .statement__stat {
    padding: 40px 24px;
    text-align: center;
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .statement__number { font-size: clamp(40px, 4vw, 56px); }
  .statement__label { margin: 8px 0 0; font-size: 15px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Statement",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built around one rule: it has to fit under the seat" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Number",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "20 L" },
        { "type": "text", "id": "label", "label": "Label", "default": "Capacity" }
      ]
    }
  ],
  "max_blocks": 3
}
{% endschema %}
