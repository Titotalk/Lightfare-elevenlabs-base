<section class="values container">
  {% if section.settings.heading != blank %}
    <p class="values__heading muted">{{ section.settings.heading }}</p>
  {% endif %}
  <ul class="values__list">
    {% for block in section.blocks %}
      <li class="values__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
    {% endfor %}
  </ul>
</section>

{% stylesheet %}
  .values { padding-top: 72px; text-align: center; }
  .values__heading { margin: 0 0 24px; font-size: 15px; }
  .values__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .values__item {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #8A8A8A;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Value strip",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for carry-on only" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping" }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
